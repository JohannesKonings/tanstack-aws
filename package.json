    "@aws-sdk/util-dynamodb": "^3.978.0",
    "@faker-js/faker": "^10.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^0.3.0",
    "@tanstack/ai-client": "^0.3.0",
    "@tanstack/ai-react": "^0.3.0",
    "@tanstack/query-db-collection": "^1.0.21",
    "@tanstack/react-db": "0.1.68",
    "@tanstack/react-devtools": "^0.9.3",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.157.16",
    "@tanstack/react-router-devtools": "^1.157.16",
    "@tanstack/react-router-ssr-query": "^1.157.16",
    "@tanstack/react-start": "^1.157.16",
    "@tanstack/react-store": "^0.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.8.0",
    "@trpc/client": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "@trpc/tanstack-react-query": "^11.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrodb": "^3.5.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.563.0",
    "nitro": "3.0.1-alpha.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "2.1.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "vite-tsconfig-paths": "^6.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-cdk/mixins-preview": "2.236.0-alpha.0",
    "@tanstack/devtools-event-client": "^0.4.0",
    "@tanstack/devtools-vite": "^0.4.1",
    "@tanstack/react-ai-devtools": "^0.2.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "aws-cdk": "^2.1104.0",
    "aws-cdk-lib": "2.236.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "constructs": "^10.4.5",
    "esbuild": "^0.27.0",
    "jsdom": "^27.4.0",
    "knip": "5.82.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "8.0.0-beta.11",
    "vite-plus": "^0.1.11"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "minimumReleaseAgeExclude": [
      "@tanstack/ai",
      "@tanstack/ai-client",
      "@tanstack/ai-react",
      "@tanstack/react-ai-devtools"
    ]
