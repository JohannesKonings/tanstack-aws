{
  "name": "tanstack-aws",
  "private": true,
  "type": "module",
  "imports": {
    "#src/webapp/components/*": "./src/webapp/components/*.tsx",
    "#src/webapp/hooks/*": "./src/webapp/hooks/*.ts",
    "#src/webapp/lib/*": "./src/webapp/lib/*.ts",
    "#src/webapp/types/*": "./src/webapp/types/*.ts",
    "#src/webapp/data/*": "./src/webapp/data/*.ts",
    "#src/webapp/db-collections/*": "./src/webapp/db-collections/*.ts",
    "#src/webapp/integrations/tanstack-query/*": "./src/webapp/integrations/tanstack-query/*.tsx",
    "#src/webapp/integrations/bedrock-adapter": "./src/webapp/integrations/bedrock-adapter/index.ts",
    "#src/webapp/integrations/*": "./src/webapp/integrations/*.ts",
    "#src/webapp/utils/*": "./src/webapp/utils/*.ts"
  },
  "scripts": {
    "webapp:dev": "vp dev --port 3000",
    "build": "node scripts/generate-robots-txt.ts && vp -C . build",
    "webapp:build": "vp run build",
    "webapp:serve": "node .output/server/index.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "generate:robots": "node scripts/generate-robots-txt.ts",
    "test": "vp test",
    "test:bedrock": "tsx scripts/test-bedrock-chat.ts",
    "test:bedrock-budget": "tsx scripts/test-bedrock-budget.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cdk": "cdk",
    "cdk:account": "vp -C apps/account-setup exec cdk",
    "seed:persons": "node scripts/seed-persons.ts",
    "compile": "tsc",
    "intent:list": "intent list",
    "intent:list:json": "intent list --json",
    "intent:install": "intent install",
    "ds:build": "vp -C packages/tanstack-ds run build",
    "ds:add": "vp dlx shadcn@latest add"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1081.0",
    "@aws-sdk/client-cloudwatch": "3.1081.0",
    "@aws-sdk/client-dynamodb": "3.1081.0",
    "@aws-sdk/client-rds-data": "3.1081.0",
    "@aws-sdk/lib-dynamodb": "3.1081.0",
    "@aws-sdk/util-dynamodb": "3.996.5",
    "@faker-js/faker": "^10.5.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/ai": "^0.13.0",
    "@tanstack/ai-client": "^0.7.14",
    "@tanstack/ai-react": "^0.7.15",
    "@tanstack/query-db-collection": "^1.0.47",
    "@tanstack/react-db": "0.1.92",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/react-store": "^0.9.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.9.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrodb": "^3.9.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "2.5.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jaykingson/vite-plus-base": "0.0.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-event-client": "^0.4.4",
    "@tanstack/devtools-vite": "^0.6.1",
    "@tanstack/intent": "0.0.23",
    "@tanstack/react-ai-devtools": "^0.2.65",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "aws-cdk": "2.1129.0",
    "aws-cdk-lib": "2.244.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.6.0",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "knip": "6.25.0",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
