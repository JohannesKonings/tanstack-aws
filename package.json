{
  "name": "tanstack-aws",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "webapp:dev": "NODE_OPTIONS='--max-http-header-size=32768' vite dev --port 3000",
    "webapp:build": "node scripts/generate-robots-txt.ts && vite build && node scripts/fix-ssr-bundle-order.mjs",
    "webapp:serve": "node .output/server/index.mjs",
    "generate:robots": "node scripts/generate-robots-txt.ts",
    "test": "vitest run",
    "test:bedrock": "tsx scripts/test-bedrock-chat.ts",
    "test:bedrock-budget": "tsx scripts/test-bedrock-budget.ts",
    "lint": "oxlint . --type-aware",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt . -c .oxfmtrc.json",
    "format:check": "pnpm format --check",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cdk": "cdk",
    "seed:persons": "node scripts/seed-persons.ts",
    "compile": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.978.0",
    "@aws-sdk/client-cloudwatch": "^3.980.0",
    "@aws-sdk/client-dynamodb": "^3.980.0",
    "@aws-sdk/lib-dynamodb": "^3.980.0",
    "@aws-sdk/util-dynamodb": "^3.980.0",
    "@faker-js/faker": "^10.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^0.3.0",
    "@tanstack/ai-client": "^0.3.0",
    "@tanstack/ai-react": "^0.3.0",
    "@tanstack/query-db-collection": "^1.0.22",
    "@tanstack/react-db": "0.1.69",
    "@tanstack/react-devtools": "^0.9.4",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-router-devtools": "^1.157.18",
    "@tanstack/react-router-ssr-query": "^1.157.18",
    "@tanstack/react-start": "^1.157.18",
    "@tanstack/react-store": "^0.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.8.0",
    "@trpc/client": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "@trpc/tanstack-react-query": "^11.9.0",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrodb": "^3.5.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.563.0",
    "nitro": "3.0.1-alpha.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "2.1.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "vite-tsconfig-paths": "^6.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-cdk/mixins-preview": "2.236.0-alpha.0",
    "@tanstack/devtools-event-client": "^0.4.0",
    "@tanstack/devtools-vite": "^0.5.0",
    "@tanstack/react-ai-devtools": "^0.2.2",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "aws-cdk": "^2.1104.0",
    "aws-cdk-lib": "2.236.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "constructs": "^10.4.5",
    "esbuild": "^0.27.0",
    "jsdom": "^27.4.0",
    "knip": "5.82.1",
    "oxfmt": "0.27.0",
    "oxlint": "1.42.0",
    "oxlint-tsgolint": "^0.11.4",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "8.0.0-beta.11",
    "vitest": "^4.0.18"
  }
}
