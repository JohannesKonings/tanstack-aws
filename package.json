{
  "name": "tanstack-aws",
  "private": true,
  "type": "module",
  "imports": {
    "#apps/webapp/components/*": "./apps/webapp/src/components/*.tsx",
    "#apps/webapp/hooks/*": "./apps/webapp/src/hooks/*.ts",
    "#apps/webapp/lib/*": "./apps/webapp/src/lib/*.ts",
    "#apps/webapp/types/*": "./apps/webapp/src/types/*.ts",
    "#apps/webapp/data/*": "./apps/webapp/src/data/*.ts",
    "#apps/webapp/db-collections/*": "./apps/webapp/src/db-collections/*.ts",
    "#apps/webapp/integrations/tanstack-query/*": "./apps/webapp/src/integrations/tanstack-query/*.tsx",
    "#apps/webapp/integrations/bedrock-adapter": "./apps/webapp/src/integrations/bedrock-adapter/index.ts",
    "#apps/webapp/integrations/*": "./apps/webapp/src/integrations/*.ts",
    "#apps/webapp/utils/*": "./apps/webapp/src/utils/*.ts"
  },
  "scripts": {
    "webapp:dev": "vp -C apps/webapp dev",
    "webapp-admin:dev": "vp -C apps/webapp-admin dev --port 3001",
    "webapp-admin:build": "vp build apps/webapp-admin && node scripts/sync-public-assets.ts apps/webapp-admin/.output/public/assets",
    "build": "node scripts/generate-robots-txt.ts && vp build apps/webapp && node scripts/sync-public-assets.ts",
    "webapp:build": "vp run build",
    "webapp:serve": "node .output/server/index.mjs",
    "check": "vp check && vp exec tsc -p apps/webapp-admin/tsconfig.json --noEmit && vp exec tsc -p apps/webapp/tsconfig.json --noEmit",
    "check:fix": "vp check --fix",
    "generate:robots": "node scripts/generate-robots-txt.ts",
    "test": "vp test",
    "test:bedrock": "tsx scripts/test-bedrock-chat.ts",
    "test:bedrock-budget": "tsx scripts/test-bedrock-budget.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "cdk": "vp -C apps/cdk-app exec cdk",
    "cdk:account": "vp -C apps/cdk-account-setup exec cdk",
    "seed:persons": "node scripts/seed-persons.ts",
    "compile": "tsc",
    "intent:list": "intent list",
    "intent:list:json": "intent list --json",
    "intent:install": "intent install",
    "ds:build": "vp -C packages/tanstack-ds run registry:build",
    "ds:add": "vp dlx shadcn@latest add -c apps/webapp"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1081.0",
    "@aws-sdk/client-cloudformation": "3.1081.0",
    "@aws-sdk/client-cloudfront": "3.1081.0",
    "@aws-sdk/client-cloudwatch": "3.1081.0",
    "@aws-sdk/client-dynamodb": "3.1081.0",
    "@aws-sdk/client-rds-data": "3.1081.0",
    "@aws-sdk/lib-dynamodb": "3.1081.0",
    "@aws-sdk/util-dynamodb": "3.996.5",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@jaykingson/vite-plus-base": "0.0.4",
    "@phosphor-icons/react": "^2.1.10",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/intent": "0.0.23",
    "@tanstack/react-router": "^1.170.17",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "knip": "6.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
