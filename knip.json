{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "apps/webapp/src/router.tsx",
    "apps/webapp/src/routes/**/*.{ts,tsx}",
    "apps/cdk-app/bin/app.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": [
    "apps/webapp/src/**/*.{ts,tsx}",
    "apps/cdk-app/**/*.{ts,tsx}",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ],
  "paths": {
    "#apps/webapp/*": ["./apps/webapp/src/*"]
  },
  "ignore": ["apps/webapp/src/routeTree.gen.ts"],
  "vite": {
    "config": ["apps/webapp/vite.config.ts"]
  },
  "vitest": true,
  "typescript": {
    "config": ["tsconfig.json", "apps/webapp/tsconfig.json"]
  }
}
