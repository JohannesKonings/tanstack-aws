          "accent": "var(--color-background-subtle)",
          "accent-foreground": "var(--color-text-primary)",
          "destructive": "var(--color-action-destructive)",
          "destructive-foreground": "#ffffff",
          "border": "var(--color-border-default)",
          "input": "var(--color-border-default)",
          "ring": "var(--color-border-focus)",
          "chart-1": "var(--color-category-framework)",
          "chart-2": "var(--color-category-data)",
          "chart-3": "var(--color-category-ui)",
          "chart-4": "var(--color-category-performance)",
          "chart-5": "var(--color-accent-creative)",
          "radius": "0.5rem",
          "sidebar": "var(--color-background-surface)",
          "sidebar-foreground": "var(--color-text-primary)",
          "sidebar-primary": "var(--color-action-primary)",
          "sidebar-primary-foreground": "var(--color-action-primary-text)",
          "sidebar-accent": "var(--color-background-subtle)",
          "sidebar-accent-foreground": "var(--color-text-primary)",
          "sidebar-border": "var(--color-border-default)",
          "sidebar-ring": "var(--color-border-focus)"
