{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "TanStack DS Theme",
      "description": "DS design tokens, self-hosted fonts, and shadcn semantic variable bridge.",
      "files": [
        {
          "path": "ds-tokens.css",
          "type": "registry:file",
          "target": "src/webapp/styles/ds-tokens.css"
        },
        {
          "path": "ds-fonts.css",
          "type": "registry:file",
          "target": "src/webapp/styles/ds-fonts.css"
        },
        {
          "path": "fonts/Inter-latin.woff2",
          "type": "registry:file",
          "target": "public/fonts/Inter-latin.woff2"
        },
        {
          "path": "fonts/Inter-latin-ext.woff2",
          "type": "registry:file",
          "target": "public/fonts/Inter-latin-ext.woff2"
        },
        {
          "path": "fonts/BricolageGrotesque-latin-wght-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/BricolageGrotesque-latin-wght-normal.woff2"
        },
        {
          "path": "fonts/IBMPlexMono-latin-300-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-300-normal.woff2"
        },
        {
          "path": "fonts/IBMPlexMono-latin-400-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-400-normal.woff2"
        },
        {
          "path": "fonts/IBMPlexMono-latin-500-normal.woff2",
          "type": "registry:file",
