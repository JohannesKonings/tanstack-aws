{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "tanstack-ds",
  "homepage": "https://tanstack.com/ds",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "TanStack DS Theme",
      "description": "DS design tokens, self-hosted fonts, and shadcn semantic variable bridge.",
      "files": [
        {
          "path": "registry/theme/ds-tokens.css",
          "type": "registry:file",
          "target": "src/webapp/styles/ds-tokens.css"
        },
        {
          "path": "registry/theme/ds-fonts.css",
          "type": "registry:file",
          "target": "src/webapp/styles/ds-fonts.css"
        },
        {
          "path": "registry/theme/fonts/Inter-latin.woff2",
          "type": "registry:file",
          "target": "public/fonts/Inter-latin.woff2"
        },
        {
          "path": "registry/theme/fonts/Inter-latin-ext.woff2",
          "type": "registry:file",
          "target": "public/fonts/Inter-latin-ext.woff2"
        },
        {
          "path": "registry/theme/fonts/BricolageGrotesque-latin-wght-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/BricolageGrotesque-latin-wght-normal.woff2"
        },
        {
          "path": "registry/theme/fonts/IBMPlexMono-latin-300-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-300-normal.woff2"
        },
        {
          "path": "registry/theme/fonts/IBMPlexMono-latin-400-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-400-normal.woff2"
        },
        {
          "path": "registry/theme/fonts/IBMPlexMono-latin-500-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-500-normal.woff2"
        },
        {
          "path": "registry/theme/fonts/IBMPlexMono-latin-600-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-600-normal.woff2"
        },
        {
          "path": "registry/theme/fonts/IBMPlexMono-latin-700-normal.woff2",
          "type": "registry:file",
          "target": "public/fonts/IBMPlexMono-latin-700-normal.woff2"
        }
      ],
      "cssVars": {
        "theme": {
          "font-sans": "Inter, ui-sans-serif, system-ui, sans-serif",
          "font-display": "Bricolage Grotesque, ui-sans-serif, system-ui, sans-serif",
          "font-mono": "IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
        },
        "light": {
          "background": "var(--color-background-default)",
          "foreground": "var(--color-text-primary)",
          "card": "var(--color-background-surface)",
          "card-foreground": "var(--color-text-primary)",
          "popover": "var(--color-background-elevated)",
          "popover-foreground": "var(--color-text-primary)",
          "primary": "var(--color-action-primary)",
          "primary-foreground": "var(--color-action-primary-text)",
          "secondary": "var(--color-action-secondary)",
          "secondary-foreground": "var(--color-text-primary)",
          "muted": "var(--color-background-subtle)",
          "muted-foreground": "var(--color-text-muted)",
          "accent": "var(--color-background-subtle)",
          "accent-foreground": "var(--color-text-primary)",
          "destructive": "var(--color-action-destructive)",
          "destructive-foreground": "#ffffff",
          "border": "var(--color-border-default)",
          "input": "var(--color-border-default)",
          "ring": "var(--color-border-focus)",
          "chart-1": "var(--color-category-framework)",
          "chart-2": "var(--color-category-data)",
          "chart-3": "var(--color-category-ui)",
          "chart-4": "var(--color-category-performance)",
          "chart-5": "var(--color-accent-creative)",
          "radius": "0.5rem",
          "sidebar": "var(--color-background-surface)",
          "sidebar-foreground": "var(--color-text-primary)",
          "sidebar-primary": "var(--color-action-primary)",
          "sidebar-primary-foreground": "var(--color-action-primary-text)",
          "sidebar-accent": "var(--color-background-subtle)",
          "sidebar-accent-foreground": "var(--color-text-primary)",
          "sidebar-border": "var(--color-border-default)",
          "sidebar-ring": "var(--color-border-focus)"
        },
        "dark": {
          "background": "var(--color-background-default)",
          "foreground": "var(--color-text-primary)",
          "card": "var(--color-background-surface)",
          "card-foreground": "var(--color-text-primary)",
          "popover": "var(--color-background-elevated)",
          "popover-foreground": "var(--color-text-primary)",
          "primary": "var(--color-action-primary)",
          "primary-foreground": "var(--color-action-primary-text)",
          "secondary": "var(--color-action-secondary)",
          "secondary-foreground": "var(--color-text-primary)",
          "muted": "var(--color-background-subtle)",
          "muted-foreground": "var(--color-text-muted)",
          "accent": "var(--color-background-subtle)",
          "accent-foreground": "var(--color-text-primary)",
          "destructive": "var(--color-action-destructive)",
          "destructive-foreground": "#ffffff",
          "border": "var(--color-border-default)",
          "input": "var(--color-border-default)",
          "ring": "var(--color-border-focus)",
          "chart-1": "var(--color-category-framework)",
          "chart-2": "var(--color-category-data)",
          "chart-3": "var(--color-category-ui)",
          "chart-4": "var(--color-category-performance)",
          "chart-5": "var(--color-accent-creative)",
          "radius": "0.5rem",
          "sidebar": "var(--color-background-surface)",
          "sidebar-foreground": "var(--color-text-primary)",
          "sidebar-primary": "var(--color-action-primary)",
          "sidebar-primary-foreground": "var(--color-action-primary-text)",
          "sidebar-accent": "var(--color-background-subtle)",
          "sidebar-accent-foreground": "var(--color-text-primary)",
          "sidebar-border": "var(--color-border-default)",
          "sidebar-ring": "var(--color-border-focus)"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "TanStack DS Button",
      "description": "DS Button with orthogonal variant and color axes, lift motion, and polymorphic as prop.",
      "dependencies": ["tailwind-merge"],
      "files": [
        {
          "path": "registry/ui/button.tsx",
          "type": "registry:ui",
          "target": "src/webapp/components/ui/button.tsx"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "TanStack DS Badge",
      "description": "Status and label badge with DS semantic color variants.",
      "registryDependencies": ["@tanstack-ds/theme"],
      "files": [
        {
          "path": "registry/badge/badge.tsx",
          "type": "registry:ui",
          "target": "src/webapp/components/ui/badge.tsx"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "TanStack DS Card",
      "description": "Surface card for grouped content with DS border and shadow.",
      "registryDependencies": ["@tanstack-ds/theme"],
      "files": [
        {
          "path": "registry/card/card.tsx",
          "type": "registry:ui",
          "target": "src/webapp/components/ui/card.tsx"
        }
      ]
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "title": "TanStack DS Tabs",
      "description": "Primary underline or secondary segmented tabs with full a11y semantics.",
      "registryDependencies": ["@tanstack-ds/theme"],
      "files": [
        {
          "path": "registry/tabs/tabs.tsx",
          "type": "registry:ui",
          "target": "src/webapp/components/ui/tabs.tsx"
        }
      ]
    }
  ]
}
