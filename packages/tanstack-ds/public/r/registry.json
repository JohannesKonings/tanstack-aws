          "destructive-foreground": "#ffffff",
          "border": "var(--color-border-default)",
          "input": "var(--color-border-default)",
          "ring": "var(--color-border-focus)",
          "chart-1": "var(--color-category-framework)",
          "chart-2": "var(--color-category-data)",
          "chart-3": "var(--color-category-ui)",
          "chart-4": "var(--color-category-performance)",
