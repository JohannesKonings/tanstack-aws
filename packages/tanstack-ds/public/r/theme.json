{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "TanStack DS Theme",
  "description": "DS design tokens, self-hosted fonts, and shadcn semantic variable bridge.",
  "files": [
    {
      "path": "registry/theme/ds-tokens.css",
      "content": "/* TanStack DS design tokens — adapted from tanstack.com/src/styles/app.css.\n * Primitives (@theme static) are mode-stable; html.dark flips semantic mappings.\n */\n\n@theme static {\n  /* --- Primitive color ramps (100 = lightest, 500 = darkest) --- */\n  --color-ds-green-100: #d8f0da;\n  --color-ds-green-200: #a2e1a9;\n  --color-ds-green-300: #69bc75;\n  --color-ds-green-400: #39af46;\n  --color-ds-green-500: #1d4226;\n\n  --color-ds-terracotta-100: #f9d8c4;\n  --color-ds-terracotta-200: #edaa8d;\n  --color-ds-terracotta-300: #e06e49;\n  --color-ds-terracotta-400: #d3481b;\n  --color-ds-terracotta-500: #5f1a06;\n\n  --color-ds-blue-100: #d8f0f3;\n  --color-ds-blue-200: #9cd5e2;\n  --color-ds-blue-300: #61adbf;\n  --color-ds-blue-400: #3aa3c4;\n  --color-ds-blue-500: #003e53;\n\n  --color-ds-purple-100: #cabfcc;\n  --color-ds-purple-200: #ca8ec5;\n  --color-ds-purple-300: #c56dcf;\n  --color-ds-purple-400: #b64cc7;\n  --color-ds-purple-500: #541f5d;\n\n  --color-ds-amber-100: #fef6cc;\n  --color-ds-amber-200: #fae884;\n  --color-ds-amber-300: #f4d648;\n  --color-ds-amber-400: #ffa216;\n  --color-ds-amber-500: #624a00;\n\n  --color-ds-neutral-0: #ffffff;\n  --color-ds-neutral-100: #eeebd4;\n  --color-ds-neutral-200: #aea691;\n  --color-ds-neutral-300: #756c5b;\n  --color-ds-neutral-400: #3e3529;\n  --color-ds-neutral-500: #111111;\n\n  /* Cool neutral tints (distinct from the warm neutral ramp above) */\n  --color-ds-neutral-tint-100: #e8e7e5;\n  --color-ds-neutral-tint-200: #c5c3bf;\n\n  /* --- Category brand colors ---\n     Libraries inherit their category's color as their core brand color. These\n     are semantic (reference the DS ramps at the 400 step) and flip to the 300\n     step in dark mode (see html.dark), so a single utility class like\n     `text-category-data` is mode-aware without a `dark:` variant. */\n  --color-category-framework: var(--color-ds-green-400);\n  --color-category-data: var(--color-ds-terracotta-400);\n  --color-category-ui: var(--color-ds-blue-400);\n  --color-category-performance: var(--color-ds-amber-400);\n  --color-category-tooling: var(--color-ds-neutral-300);\n\n  /* --- Library brand colors ---\n     Collapsed to the five category colors: each library aliases its category\n     rather than declaring a bespoke hue. */\n  --color-lib-start: var(--color-category-framework);\n  --color-lib-router: var(--color-category-framework);\n  --color-lib-query: var(--color-category-data);\n  --color-lib-table: var(--color-category-ui);\n  --color-lib-charts: var(--color-category-ui);\n  --color-lib-db: var(--color-category-data);\n  --color-lib-ai: var(--color-category-data);\n  --color-lib-form: var(--color-category-ui);\n  --color-lib-virtual: var(--color-category-performance);\n  --color-lib-pacer: var(--color-category-performance);\n  --color-lib-hotkeys: var(--color-category-ui);\n  --color-lib-store: var(--color-category-data);\n  --color-lib-devtools: var(--color-category-tooling);\n  --color-lib-cli: var(--color-category-tooling);\n  --color-lib-intent: var(--color-category-tooling);\n\n  /* ================================================================\n     LIBRARY CATEGORY COLORS — SINGLE SOURCE OF TRUTH.\n     Each category maps to ONE DS palette ramp. Change a category's hue\n     by swapping its ramp here and it flows everywhere it's themed:\n     the mega-menu, docs pages, and library landing pages.\n       framework → green   data → terracotta   ui → blue\n       performance → amber   tooling → neutral\n     `--color-category-<cat>` is the mode-aware LABEL color (400 light /\n     300 dark, overridden in html.dark below) used by the mega-menu and\n     docs. The `-<role>` tokens are mode-stable ramp steps the landing\n     shell composes itself (it does its own light/dark switching), so\n     they are NOT overridden in html.dark.\n     ================================================================ */\n  --color-category-framework: var(--color-ds-green-400);\n  --color-category-framework-accent: var(--color-ds-green-400);\n  --color-category-framework-bright: var(--color-ds-green-300);\n  --color-category-framework-deep: var(--color-ds-green-500);\n  --color-category-framework-tint: var(--color-ds-green-100);\n  --color-category-framework-ink: #04130a;\n  --color-category-framework-glow: 68 165 78;\n\n  --color-category-data: var(--color-ds-terracotta-400);\n  --color-category-data-accent: var(--color-ds-terracotta-400);\n  --color-category-data-bright: var(--color-ds-terracotta-300);\n  --color-category-data-deep: var(--color-ds-terracotta-500);\n  --color-category-data-tint: var(--color-ds-terracotta-100);\n  --color-category-data-ink: #000000;\n  --color-category-data-glow: 195 80 43;\n\n  --color-category-ui: var(--color-ds-blue-400);\n  --color-category-ui-accent: var(--color-ds-blue-400);\n  --color-category-ui-bright: var(--color-ds-blue-300);\n  --color-category-ui-deep: var(--color-ds-blue-500);\n  --color-category-ui-tint: var(--color-ds-blue-100);\n  --color-category-ui-ink: #031219;\n  --color-category-ui-glow: 70 157 184;\n\n  --color-category-performance: var(--color-ds-amber-400);\n  --color-category-performance-accent: var(--color-ds-amber-400);\n  --color-category-performance-bright: var(--color-ds-amber-300);\n  --color-category-performance-deep: var(--color-ds-amber-500);\n  --color-category-performance-tint: var(--color-ds-amber-100);\n  --color-category-performance-ink: #171003;\n  --color-category-performance-glow: 235 158 42;\n\n  /* tooling → neutral. The label base is a dark warm-gray for legibility on\n     light surfaces (flips to a light gray on dark, below); the landing accent\n     stays a lighter gray so the wordmark reads on the dark landing hero. */\n  --color-category-tooling: var(--color-ds-neutral-400);\n  --color-category-tooling-accent: var(--color-ds-neutral-200);\n  --color-category-tooling-bright: var(--color-ds-neutral-100);\n  --color-category-tooling-deep: var(--color-ds-neutral-400);\n  --color-category-tooling-tint: var(--color-ds-neutral-100);\n  --color-category-tooling-ink: #111111;\n  --color-category-tooling-glow: 171 165 148;\n\n  /* --- Semantic tokens (reference primitives so edits propagate) --- */\n  /* NOTE: Figma reported text/primary as #ffffff (a dark-mode/mode artifact);\n     using neutral-500 for the light context. Confirm intended value. */\n  --color-text-primary: var(--color-ds-neutral-500);\n  --color-text-secondary: var(--color-ds-neutral-400);\n  --color-text-muted: var(--color-ds-neutral-300);\n  /* Mega-menu item title rest color; brightens to text-primary on hover.\n     Light menu → muted dark; dark menu → neutral tint (see html.dark). */\n  --color-text-menu-title: var(--color-ds-neutral-400);\n  --color-text-accent: var(--color-ds-blue-500);\n  --color-text-disabled: var(--color-ds-neutral-200);\n  --color-text-inverse: #ffffff;\n  --color-text-success: var(--color-ds-green-500);\n  --color-text-warning: var(--color-ds-amber-500);\n  --color-text-error: var(--color-ds-terracotta-500);\n  --color-text-info: var(--color-ds-blue-400);\n\n  --color-background-default: #ffffff;\n  --color-background-surface: #ffffff;\n  --color-background-elevated: #ffffff;\n  --color-background-subtle: #fafafa;\n  --color-background-inverse: var(--color-ds-neutral-500);\n\n  --color-border-default: var(--color-ds-neutral-200);\n  --color-border-strong: var(--color-ds-neutral-400);\n  --color-border-subtle: var(--color-ds-neutral-100);\n  --color-border-focus: var(--color-ds-blue-400);\n  --color-border-error: var(--color-ds-terracotta-400);\n  --color-border-success: var(--color-ds-green-400);\n\n  --color-icon-default: var(--color-ds-neutral-500);\n  --color-icon-accent: var(--color-ds-blue-500);\n  --color-icon-muted: var(--color-ds-neutral-300);\n  --color-icon-inverse: #ffffff;\n  --color-icon-success: var(--color-ds-green-400);\n  --color-icon-warning: var(--color-ds-amber-400);\n  --color-icon-error: var(--color-ds-terracotta-400);\n\n  --color-action-primary: var(--color-ds-blue-500);\n  --color-action-primary-hover: var(--color-ds-blue-400);\n  --color-action-primary-text: #ffffff;\n  --color-action-secondary: var(--color-ds-neutral-100);\n  --color-action-secondary-hover: var(--color-ds-neutral-200);\n  --color-action-destructive: var(--color-ds-terracotta-400);\n  --color-action-disabled: var(--color-ds-neutral-200);\n\n  --color-status-success: var(--color-ds-green-400);\n  --color-status-success-bg: var(--color-ds-green-100);\n  --color-status-warning: var(--color-ds-amber-400);\n  --color-status-warning-bg: var(--color-ds-amber-100);\n  --color-status-error: var(--color-ds-terracotta-400);\n  --color-status-error-bg: var(--color-ds-terracotta-100);\n  --color-status-info: var(--color-ds-blue-400);\n  --color-status-info-bg: var(--color-ds-blue-100);\n\n  --color-accent-brand: var(--color-ds-blue-500);\n  --color-accent-warm: var(--color-ds-terracotta-300);\n  --color-accent-highlight: var(--color-ds-amber-300);\n  --color-accent-nature: var(--color-ds-green-400);\n  --color-accent-creative: var(--color-ds-purple-400);\n\n  /* --- Interaction-state overlays (from Figma; semi-transparent tints laid\n     over a surface). Figma exported these flat across modes; light values are\n     black tints, dark values (in html.dark) are white tints. --- */\n  --color-surface-state-hover: #1111110f; /* black 6% */\n  --color-surface-state-pressed: #1111111f; /* black 12% */\n  --color-input-bg-hover: #11111108; /* black ~3% */\n  --color-menu-item-pressed: #1111111f; /* black 12% */\n  --color-divider-subtle: var(--color-ds-neutral-100);\n  --color-divider-on-inverse: var(--color-ds-neutral-100);\n  --color-scrim: rgb(0 0 0 / 0.5);\n\n  /* --- Font families ---\n     display/heading = Bricolage Grotesque, body/label = Inter (--font-sans),\n     mono = IBM Plex Mono. Loaded globally from __root.tsx. */\n  --font-ds-display: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;\n  --font-ds-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n\n  /* --- Text styles (size / line-height / tracking / weight) --- */\n  --text-ds-display-2xl: 96px;\n  --text-ds-display-2xl--line-height: 96px;\n  --text-ds-display-2xl--letter-spacing: -1px;\n  --text-ds-display-2xl--font-weight: 800;\n  --text-ds-display-xl: 72px;\n  --text-ds-display-xl--line-height: 76px;\n  --text-ds-display-xl--letter-spacing: -0.8px;\n  --text-ds-display-xl--font-weight: 700;\n  --text-ds-display-lg: 56px;\n  --text-ds-display-lg--line-height: 60px;\n  --text-ds-display-lg--letter-spacing: -0.5px;\n  --text-ds-display-lg--font-weight: 700;\n  --text-ds-display-md: 48px;\n  --text-ds-display-md--line-height: 53px;\n  --text-ds-display-md--letter-spacing: -0.3px;\n  --text-ds-display-md--font-weight: 500;\n  --text-ds-display-sm: 40px;\n  --text-ds-display-sm--line-height: 46px;\n  --text-ds-display-sm--font-weight: 500;\n\n  --text-ds-heading-1: 36px;\n  --text-ds-heading-1--line-height: 41px;\n  --text-ds-heading-1--font-weight: 500;\n  --text-ds-heading-2: 28px;\n  --text-ds-heading-2--line-height: 34px;\n  --text-ds-heading-2--font-weight: 500;\n  --text-ds-heading-3: 24px;\n  --text-ds-heading-3--line-height: 29px;\n  --text-ds-heading-3--font-weight: 700;\n  --text-ds-heading-4: 20px;\n  --text-ds-heading-4--line-height: 25px;\n  --text-ds-heading-4--font-weight: 700;\n  --text-ds-heading-5: 16px;\n  --text-ds-heading-5--line-height: 21px;\n  --text-ds-heading-5--font-weight: 700;\n  --text-ds-heading-6: 14px;\n  --text-ds-heading-6--line-height: 18px;\n  --text-ds-heading-6--font-weight: 500;\n\n  --text-ds-body-xl: 20px;\n  --text-ds-body-xl--line-height: 32px;\n  --text-ds-body-xl--font-weight: 300;\n  --text-ds-body-lg: 18px;\n  --text-ds-body-lg--line-height: 28px;\n  --text-ds-body-lg--font-weight: 300;\n  --text-ds-body-md: 16px;\n  --text-ds-body-md--line-height: 24px;\n  --text-ds-body-md--font-weight: 300;\n  --text-ds-body-sm: 14px;\n  --text-ds-body-sm--line-height: 20px;\n  --text-ds-body-sm--font-weight: 400;\n  --text-ds-body-xs: 12px;\n  --text-ds-body-xs--line-height: 17px;\n  --text-ds-body-xs--font-weight: 400;\n\n  --text-ds-label-lg: 16px;\n  --text-ds-label-lg--line-height: 19px;\n  --text-ds-label-lg--font-weight: 500;\n  --text-ds-label-md: 14px;\n  --text-ds-label-md--line-height: 17px;\n  --text-ds-label-md--font-weight: 500;\n  --text-ds-label-sm: 12px;\n  --text-ds-label-sm--line-height: 14px;\n  --text-ds-label-sm--letter-spacing: 0.5px;\n  --text-ds-label-sm--font-weight: 500;\n\n  --text-ds-mono-display: 24px;\n  --text-ds-mono-display--line-height: 31px;\n  --text-ds-mono-display--font-weight: 400;\n  --text-ds-mono-lg: 18px;\n  --text-ds-mono-lg--line-height: 27px;\n  --text-ds-mono-lg--font-weight: 400;\n  --text-ds-mono-md: 16px;\n  --text-ds-mono-md--line-height: 24px;\n  --text-ds-mono-md--font-weight: 300;\n  --text-ds-mono-sm: 14px;\n  --text-ds-mono-sm--line-height: 21px;\n  --text-ds-mono-sm--font-weight: 300;\n  --text-ds-mono-xs: 12px;\n  --text-ds-mono-xs--line-height: 16px;\n  --text-ds-mono-xs--font-weight: 300;\n  --text-ds-mono-2xs: 10px;\n  --text-ds-mono-2xs--line-height: 14px;\n  --text-ds-mono-2xs--font-weight: 300;\n  --text-ds-mono-caps: 12px;\n  --text-ds-mono-caps--line-height: 14px;\n  --text-ds-mono-caps--letter-spacing: 1.5px;\n  --text-ds-mono-caps--font-weight: 400;\n  --text-ds-mono-caps-xs: 10px;\n  --text-ds-mono-caps-xs--line-height: 12px;\n  --text-ds-mono-caps-xs--letter-spacing: 1.2px;\n  --text-ds-mono-caps-xs--font-weight: 400;\n\n  /* Eyebrow (mono, uppercase, wide tracking) — labels above headings */\n  --text-ds-eyebrow-lg: 13px;\n  --text-ds-eyebrow-lg--line-height: 16px;\n  --text-ds-eyebrow-lg--letter-spacing: 2px;\n  --text-ds-eyebrow-lg--font-weight: 600;\n  --text-ds-eyebrow-md: 11px;\n  --text-ds-eyebrow-md--line-height: 13px;\n  --text-ds-eyebrow-md--letter-spacing: 1.75px;\n  --text-ds-eyebrow-md--font-weight: 500;\n\n  /* Overlay stacking and motion (dialog, dropdown, drawer) */\n  --z-scrim: 999;\n  --z-overlay: 1000;\n  --z-above-overlay: 1200;\n  --motion-duration-fast: 150ms;\n  --motion-ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);\n}\n\n:root,\n:host {\n  --color-gray-50: #faf8f2;\n  --color-gray-100: #f5f2e9;\n  --color-gray-200: #eae5d7;\n  --color-gray-300: #d6cfbd;\n  --color-gray-400: #aea691;\n  --color-gray-500: #7c7464;\n  --color-gray-600: #5f574a;\n  --color-gray-700: #453f34;\n  --color-gray-800: #332d24;\n  --color-gray-900: #201b15;\n  --color-gray-950: #111111;\n}\n\nhtml.dark {\n  --color-text-primary: #ffffff;\n  --color-text-secondary: #aea691;\n  --color-text-muted: #756c5b;\n  --color-text-menu-title: var(--color-ds-neutral-tint-200);\n  --color-text-accent: #61adbf;\n  --color-text-disabled: #3e3529;\n  --color-text-inverse: #111111;\n  --color-text-success: #69bc75;\n  --color-text-warning: #f4d648;\n  --color-text-error: #e06e49;\n  --color-text-info: #9cd5e2;\n\n  --color-background-default: #111111;\n  --color-background-surface: #1f1f1f;\n  --color-background-elevated: #2b2b2b;\n  --color-background-subtle: #1b1b1b;\n  --color-background-inverse: #ffffff;\n\n  --color-border-default: #2d2d2d;\n  --color-border-strong: #aea691;\n  --color-border-subtle: #232323;\n  --color-border-focus: #61adbf;\n  --color-border-error: #e06e49;\n  --color-border-success: #69bc75;\n\n  --color-icon-default: #aea691;\n  --color-icon-accent: #61adbf;\n  --color-icon-muted: #756c5b;\n  --color-icon-inverse: #111111;\n  --color-icon-success: #69bc75;\n  --color-icon-warning: #f4d648;\n  --color-icon-error: #e06e49;\n\n  --color-action-primary: #3aa3c4;\n  --color-action-primary-hover: #61adbf;\n  --color-action-primary-text: #ffffff;\n  --color-action-secondary: #2b2b2b;\n  --color-action-secondary-hover: #3a3a3a;\n  --color-action-destructive: #e06e49;\n  --color-action-disabled: #2b2b2b;\n\n  --color-status-success: #69bc75;\n  --color-status-success-bg: #1d4226;\n  --color-status-warning: #f4d648;\n  --color-status-warning-bg: #624a00;\n  --color-status-error: #e06e49;\n  --color-status-error-bg: #5f1a06;\n  --color-status-info: #61adbf;\n  --color-status-info-bg: #003e53;\n\n  --color-accent-brand: #3aa3c4;\n  --color-accent-warm: #edaa8d;\n  --color-accent-highlight: #fae884;\n  --color-accent-nature: #69bc75;\n  --color-accent-creative: #c56dcf;\n\n  /* Category brand colors step one lighter (300; tooling → neutral-200) so\n     they stay legible on dark surfaces. */\n  --color-category-framework: var(--color-ds-green-300);\n  --color-category-data: var(--color-ds-terracotta-300);\n  --color-category-ui: var(--color-ds-blue-300);\n  --color-category-performance: var(--color-ds-amber-300);\n  --color-category-tooling: var(--color-ds-neutral-200);\n\n  /* Interaction-state overlays — white tints for dark surfaces (Figma values\n     used directly where provided: input/background/hover, menu/item/pressed,\n     divider/subtle). */\n  --color-surface-state-hover: #ffffff1f; /* white 12% */\n  --color-surface-state-pressed: #ffffff29; /* white 16% */\n  --color-input-bg-hover: #ffffff0a; /* white 4% */\n  --color-menu-item-pressed: #ffffff1f; /* white 12% */\n  --color-divider-subtle: #1e1e1e;\n  --color-divider-on-inverse: #1e1e1e;\n  --color-scrim: rgb(0 0 0 / 0.65);\n}\n\n@utility corner-squircle {\n  corner-shape: squircle;\n}\n",
      "type": "registry:file",
      "target": "src/webapp/styles/ds-tokens.css"
    },
    {
      "path": "registry/theme/ds-fonts.css",
      "content": "/* Self-hosted TanStack DS fonts (Inter, Bricolage Grotesque, IBM Plex Mono). */\n\n@font-face {\n  font-display: swap;\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 100 900;\n  src: url('/fonts/Inter-latin-ext.woff2') format('woff2');\n  unicode-range:\n    U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329,\n    U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F,\n    U+A720-A7FF;\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'Inter';\n  font-style: normal;\n  font-weight: 100 900;\n  src: url('/fonts/Inter-latin.woff2') format('woff2');\n  unicode-range:\n    U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,\n    U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'Bricolage Grotesque';\n  font-style: normal;\n  font-weight: 200 800;\n  src: url('/fonts/BricolageGrotesque-latin-wght-normal.woff2') format('woff2');\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 300;\n  src: url('/fonts/IBMPlexMono-latin-300-normal.woff2') format('woff2');\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 400;\n  src: url('/fonts/IBMPlexMono-latin-400-normal.woff2') format('woff2');\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 500;\n  src: url('/fonts/IBMPlexMono-latin-500-normal.woff2') format('woff2');\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 600;\n  src: url('/fonts/IBMPlexMono-latin-600-normal.woff2') format('woff2');\n}\n\n@font-face {\n  font-display: swap;\n  font-family: 'IBM Plex Mono';\n  font-style: normal;\n  font-weight: 700;\n  src: url('/fonts/IBMPlexMono-latin-700-normal.woff2') format('woff2');\n}\n",
      "type": "registry:file",
      "target": "src/webapp/styles/ds-fonts.css"
    },
