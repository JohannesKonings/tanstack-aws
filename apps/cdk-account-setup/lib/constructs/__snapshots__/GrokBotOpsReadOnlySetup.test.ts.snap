                {
                  "Ref": "AWS::Partition",
                },
                ":iam::aws:policy/ReadOnlyAccess",
              ],
            ],
          },
        ],
        "MaxSessionDuration": 3600,
        "RoleName": "GrokBotOpsReadOnlyRole",
      },
      "Type": "AWS::IAM::Role",
    },
    "GrokBotOpsReadOnlySetupRoleDefaultPolicyA59E9514": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
