# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=us-east-2, accessKeyId=$AWS_ACCESS_KEY_ID, secretAccessKey=$AWS_SECRET_ACCESS_KEY, sessionToken=$AWS_SESSION_TOKEN)
# ---
# @optional @sensitive
AWS_ACCESS_KEY_ID=
# @optional @sensitive
AWS_SECRET_ACCESS_KEY=
# @optional @sensitive
AWS_SESSION_TOKEN=
# 12-digit AWS account ID.
# Loaded from the `envs` secret in us-east-2. See https://varlock.dev/plugins/aws-secrets/
# @required
AWS_ACCOUNT_ID=awsSecret("envs#AWS_ACCOUNT_ID")
